{
  "name": "fpl-lens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "start": "node scripts/run-vinext.mjs start",
    "test": "node scripts/run-vinext.mjs build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "research:capture": "python analysis/capture_deadline_snapshot.py",
    "research:market:capture": "python analysis/capture_market_snapshot_v2.py",
    "research:market:fit": "python analysis/fit_live_market_v2.py",
    "research:rankers": "python analysis/fit_live_listwise.py",
    "research:regime": "python analysis/fit_live_regime.py",
    "research:plan": "python analysis/chip_scenario_planner.py",
    "research:shadow": "python analysis/run_shadow_cycle.py",
    "research:cycle": "python analysis/capture_deadline_snapshot.py && python analysis/capture_market_snapshot_v2.py && python analysis/fit_live_market_v2.py && python analysis/fit_live_listwise.py && python analysis/fit_live_regime.py && python analysis/chip_scenario_planner.py && python analysis/run_shadow_cycle.py && python analysis/chip_scenario_planner.py && python analysis/run_shadow_cycle.py",
    "research:score": "python analysis/score_shadow_cycle.py",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
